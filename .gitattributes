# Normalisasi otomatis line ending sesuai OS masing-masing kontributor.
# Git akan menyimpan LF di repository, dan mengonversi ke CRLF/LF
# saat checkout sesuai OS pengguna (untuk file yang terdeteksi sebagai teks).
* text=auto

# Paksa LF untuk file kode & config, terlepas dari OS (disarankan untuk project JS)
*.js  text eol=lf
*.jsx text eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md  text eol=lf

# File biner jangan pernah dikonversi
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary